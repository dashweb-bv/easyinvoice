{
  "name": "easyinvoice",
  "version": "3.0.47",
  "packageManager": "pnpm@12.3.4",
  "description": "Easily create beautiful PDF invoices.",
  "license": "MIT",
  "homepage": "https://budgetinvoice.com",
  "author": {
    "name": "Danny Veldhoen"
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck && prettier --check .",
    "lint:staged": "lint-staged",
    "lint:commits": "commitlint",
    "format": "prettier --write .",
    "test": "pnpm run build && node --test test/*.test.mts",
    "test:coverage": "pnpm run build && node scripts/coverage.mts",
    "check": "pnpm run build && pnpm run lint && tsc -p tsconfig.check.json && node scripts/coverage.mts && pnpm run test:package",
    "test:package": "node scripts/check-package.mts",
    "test:browser": "pnpm run build && node --test test/browser.integration.mts",
    "release": "semantic-release",
    "prepare": "husky",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bugs": {
    "url": "https://github.com/dashweb-bv/easyinvoice/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dashweb-bv/easyinvoice.git"
  },
  "keywords": [
    "invoice",
    "quote",
    "estimate",
    "bill",
    "pdf",
    "generator"
  ],
  "peerDependencies": {
    "pdfjs-dist": "^6.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.13.4",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "js-base64": "^3.9.3",
    "print-js": "^1.6.0"
  },
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/easyinvoice.min.js": "./dist/easyinvoice.min.js",
    "./dist/easyinvoice.min.js.map": "./dist/easyinvoice.min.js.map",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "unpkg": "./dist/easyinvoice.min.js",
  "jsdelivr": "./dist/easyinvoice.min.js",
  "engines": {
    "node": ">=22.14.0"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  }
}
